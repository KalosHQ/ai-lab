# Kalos AI Configuration
# Copy this file to .env and update the values

# SMPL-X Model Directory
# Default: models/smplx
# For deployment, set this to where your models are stored
# Examples:
#   Local: C:/models/smplx or /home/user/models/smplx
#   Colab: /content/drive/MyDrive/models/smplx
#   Docker: /app/models/smplx
SMPLX_MODEL_DIR=models/smplx

# Output Directory for generated avatars
# Default: output
# For deployment, consider using a persistent storage location
SMPLX_OUTPUT_DIR=output

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (for production, specify exact origins)
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# API Settings
API_TITLE=Kalos AI
API_VERSION=0.1.0

# Environment (development, staging, production)
ENVIRONMENT=development